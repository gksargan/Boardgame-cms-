# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Analytics & Monitoring
VITE_ANALYTICS_KEY=optional-analytics-key

# Optional: Payment Integration
VITE_STRIPE_KEY=optional-stripe-public-key
VITE_RAZORPAY_KEY=optional-razorpay-key

# Optional: Email Service
VITE_EMAILJS_SERVICE_ID=optional-emailjs-service
VITE_EMAILJS_TEMPLATE_ID=optional-emailjs-template

# Optional: Feature Flags
VITE_ENABLE_BOOKINGS=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_PAYMENTS=false

# Note: Never commit this file! Use .env.local for local development.
# For production, set these in your hosting platform's environment variables.
